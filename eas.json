{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "preview" }
    },
    "staging": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "staging",
      "android": { "buildType": "app-bundle" },
      "ios": { "image": "latest" },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_ALL_PREMIUM": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": { "buildType": "app-bundle" },
      "ios": { "image": "latest" },
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "appleId": "giampietro.leonoro@gmail.com",
        "ascAppId": "6767235969",
        "appleTeamId": "AFD5T627MN"
      }
    },
    "production": {
      "ios": {
        "appleId": "giampietro.leonoro@gmail.com",
        "ascAppId": "6767235969",
        "appleTeamId": "AFD5T627MN"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
